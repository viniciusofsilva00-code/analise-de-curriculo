{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anchorbrasil.local/processo.schema.json",
  "title": "Processo seletivo (processo.json)",
  "description": "Formato único das duas portas (skill /analise-de-curriculo e app do claude.ai). O painel renderiza qualquer documento válido.",
  "type": "object",
  "required": ["schemaVersion", "vaga", "criterios", "candidatos", "top3", "perguntas"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "geradoPor": { "type": "string", "description": "skill | app" },
    "geradoEm": { "type": "string" },
    "vaga": {
      "type": "object",
      "required": ["id", "titulo", "data", "exigePresenca", "afirmativa"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "titulo": { "type": "string", "minLength": 1 },
        "cargo": { "type": "string" },
        "empresa": { "type": "string" },
        "area": { "type": "string" },
        "local": { "type": "string" },
        "modelo": { "enum": ["presencial", "hibrido", "remoto", ""] },
        "contrato": { "type": "string" },
        "faixa": { "type": "string" },
        "senioridade": { "type": "string" },
        "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "exigePresenca": { "type": "boolean", "description": "true para presencial ou híbrido: só então a cidade do candidato aparece" },
        "afirmativa": { "type": "string", "description": "vazio = vaga não afirmativa; texto = descrição da vaga afirmativa declarada pelo usuário" },
        "fonteRequisitos": { "type": "string" },
        "requisitosTexto": { "type": "string" }
      }
    },
    "criterios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nome", "tipo", "peso"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "nome": { "type": "string", "minLength": 1 },
          "tipo": { "enum": ["O", "D"], "description": "O = obrigatório, D = desejável" },
          "peso": { "type": "number", "minimum": 0 },
          "descricao": { "type": "string" }
        }
      }
    },
    "candidatos": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidato" }
    },
    "top3": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "avisos": { "type": "array", "items": { "type": "string" } },
    "perguntas": {
      "type": "object",
      "required": ["comuns", "porCandidato"],
      "additionalProperties": false,
      "properties": {
        "comuns": { "type": "array", "items": { "$ref": "#/$defs/perguntaB" } },
        "porCandidato": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["A", "B7"],
            "additionalProperties": false,
            "properties": {
              "A": { "type": "array", "items": { "$ref": "#/$defs/perguntaA" } },
              "B7": { "$ref": "#/$defs/perguntaB" }
            }
          }
        }
      }
    },
    "respostas": { "$ref": "#/$defs/respostas" }
  },
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "nota": {
      "type": "object",
      "required": ["nota", "trecho", "natureza"],
      "additionalProperties": false,
      "properties": {
        "nota": { "type": "integer", "minimum": 0, "maximum": 5 },
        "trecho": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "trecho literal do currículo; fragmentos separados por ' … '; 'Sem menção' quando ausente" },
        "natureza": { "enum": ["escrito", "declarado", "inferencia", "ausente"] },
        "comentario": { "type": "string" }
      }
    },
    "citacao": {
      "type": "object",
      "required": ["texto", "trecho"],
      "additionalProperties": false,
      "properties": {
        "texto": { "$ref": "#/$defs/texto" },
        "trecho": { "$ref": "#/$defs/texto" },
        "inferencia": { "type": "boolean" }
      }
    },
    "candidato": {
      "type": "object",
      "required": ["id", "nome", "arquivo", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "nome": { "$ref": "#/$defs/texto" },
        "arquivo": { "type": "string" },
        "cidade": { "type": "string" },
        "cargo": { "type": "string" },
        "status": { "enum": ["aprovado", "eliminado", "limitrofe", "nao_avaliado"] },
        "motivo": { "type": "string" },
        "requisitosFaltantes": { "type": "array", "items": { "type": "string", "pattern": "^C[0-9]+$" } },
        "criterioInclusao": { "type": "string" },
        "ordemRecencia": { "type": "integer", "minimum": 1 },
        "notas": {
          "type": "object",
          "propertyNames": { "pattern": "^C[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/nota" }
        },
        "fortes": { "type": "array", "items": { "$ref": "#/$defs/citacao" } },
        "riscos": { "type": "array", "items": { "$ref": "#/$defs/citacao" } },
        "inconsistencias": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["texto"],
            "additionalProperties": false,
            "properties": { "texto": { "$ref": "#/$defs/texto" }, "inferencia": { "type": "boolean" } }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["aprovado", "limitrofe"] } } },
          "then": { "required": ["notas"] } },
        { "if": { "properties": { "status": { "const": "aprovado" } } },
          "then": { "required": ["ordemRecencia"] } },
        { "if": { "properties": { "status": { "enum": ["eliminado", "limitrofe"] } } },
          "then": { "required": ["motivo", "requisitosFaltantes"] } },
        { "if": { "properties": { "status": { "const": "limitrofe" } } },
          "then": { "required": ["criterioInclusao", "ordemRecencia"] } },
        { "if": { "properties": { "status": { "const": "nao_avaliado" } } },
          "then": { "required": ["motivo"] } }
      ]
    },
    "perguntaA": {
      "type": "object",
      "required": ["id", "crit", "trecho", "q", "boa", "alerta"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^A[0-9]+$" },
        "crit": { "type": "string", "pattern": "^C[0-9]+$" },
        "trecho": { "$ref": "#/$defs/texto" },
        "q": { "$ref": "#/$defs/texto" },
        "boa": { "$ref": "#/$defs/texto" },
        "alerta": { "$ref": "#/$defs/texto" }
      }
    },
    "perguntaB": {
      "type": "object",
      "required": ["id", "crit", "q", "a1", "a3", "a5"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^B[0-9]+$" },
        "crit": { "type": "string", "pattern": "^C[0-9]+$" },
        "q": { "$ref": "#/$defs/texto" },
        "a1": { "$ref": "#/$defs/texto" },
        "a3": { "$ref": "#/$defs/texto" },
        "a5": { "$ref": "#/$defs/texto" }
      }
    },
    "respostas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pesos": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "fase": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "t": { "type": "number", "minimum": 0 }, "v": { "type": "number", "minimum": 0 }, "a": { "type": "number", "minimum": 0 } }
        },
        "incluirLimitrofes": { "type": "array", "items": { "type": "string" } },
        "resp": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "A": { "type": "object", "additionalProperties": {
                "type": "object", "properties": { "s": { "enum": ["", "C", "P", "N"] }, "n": { "type": "string" } } } },
              "B": { "type": "object", "additionalProperties": {
                "type": "object", "properties": { "s": { "type": "integer", "minimum": 0, "maximum": 5 }, "n": { "type": "string" } } } }
            }
          }
        },
        "decisao": {
          "type": "object",
          "properties": { "cand": { "type": "string" }, "texto": { "type": "string" } }
        },
        "salvoEm": { "type": ["string", "null"] }
      }
    }
  }
}
